<!-- WPF/Views/Brands/BrandListWindow.xaml -->
<Window x:Class="MusicShop.WPF.Views.Brand.BrandListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory — Brands"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindow}"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">
    <DockPanel LastChildFill="True" Margin="16">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Search" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="2,0,0,4"/>
                    <TextBox Style="{StaticResource TextBoxBase}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Type brand name"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
                    <Button Content="Search" Margin="0,0,8,0" Padding="16,6"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding SearchCommand}"/>
                    <Button Content="Refresh" Padding="16,6"
                            Style="{StaticResource ButtonGhost}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="+ Add" Margin="0,0,8,0" Padding="16,6"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding AddCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="16,0,16,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="◀ Prev" Margin="0,0,8,0" Padding="12,6"
                        Style="{StaticResource ButtonGhost}"
                        Command="{Binding PrevPageCommand}"/>
                <Button Content="Next ▶" Padding="12,6"
                        Style="{StaticResource ButtonGhost}"
                        Command="{Binding NextPageCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Foreground="{StaticResource FgMuted}" Text="{Binding PageInfo}" />
                <TextBlock Text="  •  " Foreground="{StaticResource FgMuted}" />
                <TextBlock Foreground="{StaticResource FgMuted}" Text="{Binding StatusText}" />
            </StackPanel>
        </DockPanel>

        <!-- Grid -->
        <Border Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="12">
            <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource DataGridBase}" AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id"          Binding="{Binding Id}"          Width="80"/>
                    <DataGridTextColumn Header="Name"        Binding="{Binding Name}"        Width="*"/>
                    <DataGridTextColumn Header="Items"       Binding="{Binding ItemsCount}"  Width="120"/>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Actions" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Edit"
                                            Style="{StaticResource ButtonGhost}"
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Delete"
                                            Style="{StaticResource ButtonGhost}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
