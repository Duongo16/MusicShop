<Page x:Class="MusicShop.WPF.Views.Order.OrderListWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:MusicShop.WPF.Views.Order"
      mc:Ignorable="d"
      Title="Orders — Manager" 
      Background="{StaticResource BgWindow}">
    <Grid Margin="16" Background="{StaticResource BgCard}">
        <DockPanel LastChildFill="True">

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12">
                <TextBox Width="260" Margin="0,0,8,0" VerticalAlignment="Center"
                         Style="{StaticResource TextBoxBase}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />

                <Button Content="Search" Margin="0,0,8,0" 
                        Style="{StaticResource ButtonPrimary}" Command="{Binding SearchCommand}" />

                <Button Content="Refresh" 
                        Style="{StaticResource ButtonGhost}" Command="{Binding RefreshCommand}" />

                <TextBlock Text="{Binding PageInfo}" Margin="16,0,0,0" VerticalAlignment="Center" 
                           Foreground="{StaticResource FgMuted}"/>
                <Border Width="1" Background="Transparent" HorizontalAlignment="Stretch" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="◀ Prev" Margin="8,0,8,0" 
                            Style="{StaticResource ButtonGhost}" Command="{Binding PrevPageCommand}" />
                    <Button Content="Next ▶" 
                            Style="{StaticResource ButtonGhost}" Command="{Binding NextPageCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"  
                        Width="240"  
                        Margin="0,0,12,12">

                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedOrder}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="UPDATE ORDER STATUS"  
                           Foreground="{StaticResource FgMuted}"  
                           Margin="12,12,12,4"/>

                <TextBlock Text="{Binding SelectedOrder.OrderNumber}"  
                           Margin="12,0,12,12"  
                           FontWeight="Bold"
                           FontSize="14"/>

                <TextBlock Text="New Status"  
                           Foreground="{StaticResource FgMuted}"  
                           Margin="12,0,12,4"/>

                <ComboBox Style="{StaticResource ComboBoxBase}" Margin="12,0,12,12"
                          ItemsSource="{Binding OrderStatuses}"
                          SelectedItem="{Binding NewSelectedStatus, Mode=TwoWay}"/>

                <Button Content="Update Status"
                        Margin="12,8,12,12"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding UpdateStatusCommand}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Orders}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectedItem="{Binding SelectedOrder}" Style="{StaticResource DataGridBase}"
                      Margin="12,0,12,12">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="OrderNumber" Binding="{Binding OrderNumber}" Width="180" />
                    <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt, StringFormat='g'}" Width="180" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='c'}" Width="120" />
                    <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

        </DockPanel>
    </Grid>
</Page>