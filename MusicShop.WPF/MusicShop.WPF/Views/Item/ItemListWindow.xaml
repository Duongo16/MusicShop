<Window x:Class="MusicShop.WPF.Views.Item.ItemListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item Management"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindow}"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <DockPanel LastChildFill="True" Margin="16">

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Search" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="2,0,0,4"/>
                    <TextBox Style="{StaticResource TextBoxBase}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Type name or SKU to filter"/>
                </StackPanel>

                <!-- Status -->
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Status" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="2,0,0,4"/>
                    <ComboBox Style="{StaticResource ComboBoxBase}"
                              ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding SelectedStatus}"
                              ToolTip="Filter by item status"/>
                </StackPanel>

                <!-- Type -->
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Type" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="2,0,0,4"/>
                    <ComboBox Style="{StaticResource ComboBoxBase}"
                              ItemsSource="{Binding ItemTypes}"
                              SelectedItem="{Binding SelectedItemType}"
                              ToolTip="Filter by item type"/>
                </StackPanel>

                <!-- Brand -->
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Brand" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="2,0,0,4"/>
                    <ComboBox Style="{StaticResource ComboBoxBase}"
                          ItemsSource="{Binding Brands}"
                          DisplayMemberPath="Name" 
                          SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                          ToolTip="Filter by brand"
                          TextSearch.TextPath="Name">
                    </ComboBox>
                </StackPanel>

                <!-- Category -->
                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Text="Category" Foreground="{StaticResource FgMuted}" FontSize="12" Margin="2,0,0,4"/>
                    <ComboBox Style="{StaticResource ComboBoxBase}"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              ToolTip="Filter by category"/>
                </StackPanel>

                <!-- Spacer -->
                <StackPanel Grid.Column="5"/>

                <!-- Buttons -->
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Content="+ Add" Margin="0,0,8,0" Padding="16,6"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding AddCommand}"/>
                    <Button Content="Search" Margin="0,0,8,0" Padding="16,6"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding SearchCommand}"/>
                    <Button Content="Refresh" Padding="16,6"
                            Style="{StaticResource ButtonGhost}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="16">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="◀ Prev" Margin="0,0,8,0" Padding="12,6"
                            Style="{StaticResource ButtonGhost}"
                            Command="{Binding PrevPageCommand}"/>
                    <Button Content="Next ▶" Padding="12,6"
                            Style="{StaticResource ButtonGhost}"
                            Command="{Binding NextPageCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Foreground="{StaticResource FgMuted}" Text="{Binding PageInfo}"/>
                    <TextBlock Text=" • " Foreground="{StaticResource FgMuted}"/>
                    <TextBlock Foreground="{StaticResource FgMuted}" Text="{Binding StatusText}"/>
                </StackPanel>
            </DockPanel>
        </DockPanel>

        <!-- Grid -->
        <DataGrid ItemsSource="{Binding Items}"
          Style="{StaticResource DataGridBase}"
          AlternationCount="2"
          MouseDoubleClick="DataGrid_MouseDoubleClick"
          HeadersVisibility="Column"
          ColumnHeaderHeight="36"
          FrozenColumnCount="1"
          CanUserReorderColumns="True"
          CanUserResizeColumns="True"
          EnableRowVirtualization="True"
          GridLinesVisibility="None">

            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Img" Width="64" MinWidth="64" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="40" Height="40" CornerRadius="8"
                            Background="{StaticResource BgMute}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" SnapsToDevicePixels="True"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Name" Width="2*"
                                SortMemberPath="Name" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FgPrimary}"
                                   TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                   ToolTip="{Binding Name}"/>
                                <TextBlock Text="{Binding Description}"
                                   Foreground="{StaticResource FgMuted}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Description}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="SKU" Width="120" MinWidth="100"
                            Binding="{Binding Sku}" SortMemberPath="Sku" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Sku}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Type" Width="96" MinWidth="88" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="8,2" Background="{StaticResource TagBg}">
                                <TextBlock Text="{Binding ItemType}" FontSize="12" Foreground="{StaticResource FgPrimary}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ItemType}"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Brand" Width="140" MinWidth="120"
                            Binding="{Binding Brand.Name}" SortMemberPath="Brand.Name" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Brand.Name}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Category" Width="140" MinWidth="120"
                            Binding="{Binding Category.Name}" SortMemberPath="Category.Name" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Category.Name}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Status" Width="112" MinWidth="100" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="8,2" Background="{StaticResource TagBg}">
                                <TextBlock Text="{Binding Status}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Price" Width="140" MinWidth="120" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- Giá gốc -->
                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0}}"
                                   Margin="0,0,6,0"
                                   Foreground="{StaticResource FgMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextDecorations" Value="{x:Null}"/>
                                            <Style.Triggers>
                                                <!-- Không có SalePrice: hiển thị bình thường, đậm màu -->
                                                <DataTrigger Binding="{Binding SalePrice}" Value="{x:Null}">
                                                    <Setter Property="Foreground" Value="{StaticResource FgPrimary}"/>
                                                    <Setter Property="TextDecorations" Value="{x:Null}"/>
                                                </DataTrigger>
                                                <!-- Có SalePrice: gạch -->
                                                <DataTrigger Binding="{Binding SalePrice}">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Giá sale -->
                                <TextBlock Text="{Binding SalePrice, StringFormat={}{0:N0}}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Success}"
                                   Visibility="Collapsed">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SalePrice}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SalePrice}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Stock" Width="96" MinWidth="90" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding StockQty}" FontWeight="SemiBold"/>
                                <TextBlock Text="/" Margin="4,0" Foreground="{StaticResource FgMuted}"/>
                                <TextBlock Text="{Binding ReorderLevel}" Foreground="{StaticResource FgMuted}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Updated" Width="140" MinWidth="120" IsReadOnly="True"
                            Binding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                            SortMemberPath="UpdatedAt">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="" Width="88" MinWidth="80" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ButtonGhost}"
                                    Width="32" Height="28" Margin="0,0,4,0"
                                    ToolTip="Update"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                    <TextBlock Text="U"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <Button Style="{StaticResource ButtonGhost}"
                                    Width="32" Height="28"
                                    ToolTip="Delete"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}">
                                    <TextBlock Text="X"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#DC2626"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>        
                                </Button>
                            </StackPanel>


                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

            <!-- Context menu -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit"
                      Command="{Binding PlacementTarget.DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Delete"
                      Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

    </DockPanel>
</Window>
