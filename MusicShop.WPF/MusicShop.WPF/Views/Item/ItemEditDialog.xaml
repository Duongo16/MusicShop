<Window x:Class="MusicShop.WPF.Views.Item.ItemEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgWindow}"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16" Background="{StaticResource BgCard}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="12">
                <StackPanel Width="240" Margin="0,0,12,0">
                    <TextBlock Text="SKU" Foreground="{StaticResource FgMuted}" Margin="2,0,0,4"/>
                    <TextBox Style="{StaticResource TextBoxBase}"
                             Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Width="420">
                    <TextBlock Text="Name" Foreground="{StaticResource FgMuted}" Margin="2,0,0,4"/>
                    <TextBox Style="{StaticResource TextBoxBase}"
                             Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>

            <!-- Price / Sale / Stock / Reorder -->
            <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="12">
                <StackPanel Width="170" Margin="0,0,12,0">
                    <TextBlock Text="Price" Foreground="{StaticResource FgMuted}" Margin="2,0,0,4"/>
                    <TextBox Style="{StaticResource TextBoxBase}"
                             Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Width="170" Margin="0,0,12,0">
                    <TextBlock Text="SalePrice" Foreground="{StaticResource FgMuted}" Margin="2,0,0,4"/>
                    <TextBox Style="{StaticResource TextBoxBase}"
                             Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Width="150" Margin="0,0,12,0">
                    <TextBlock Text="StockQty" Foreground="{StaticResource FgMuted}" Margin="2,0,0,4"/>
                    <TextBox Style="{StaticResource TextBoxBase}"
                             Text="{Binding StockQty, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Width="150">
                    <TextBlock Text="ReorderLevel" Foreground="{StaticResource FgMuted}" Margin="2,0,0,4"/>
                    <TextBox Style="{StaticResource TextBoxBase}"
                             Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>

            <!-- Type / Status -->
            <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="12">
                <StackPanel Width="240" Margin="0,0,12,0">
                    <TextBlock Text="ItemType" Foreground="{StaticResource FgMuted}" Margin="2,0,0,4"/>
                    <ComboBox Style="{StaticResource ComboBoxBase}"
                              ItemsSource="{Binding ItemTypes}"
                              SelectedItem="{Binding ItemType, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Width="240">
                    <TextBlock Text="Status" Foreground="{StaticResource FgMuted}" Margin="2,0,0,4"/>
                    <ComboBox Style="{StaticResource ComboBoxBase}"
                              ItemsSource="{Binding ItemStatuses}"
                              SelectedItem="{Binding Status, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <!-- Brand / Category / Image -->
            <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="12">
                <StackPanel Width="240" Margin="0,0,12,0">
                    <TextBlock Text="Brand" Foreground="{StaticResource FgMuted}" Margin="2,0,0,4"/>
                    <ComboBox Style="{StaticResource ComboBoxBase}"
                              ItemsSource="{Binding Brands}"
                              SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Width="240" Margin="0,0,12,0">
                    <TextBlock Text="Category" Foreground="{StaticResource FgMuted}" Margin="2,0,0,4"/>
                    <ComboBox Style="{StaticResource ComboBoxBase}"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Width="220">
                    <TextBlock Text="Image URL" Foreground="{StaticResource FgMuted}" Margin="2,0,0,4"/>
                    <TextBox Style="{StaticResource TextBoxBase}"
                             Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </StackPanel>

            <!-- Description -->
            <StackPanel Grid.Row="4" Margin="12">
                <TextBlock Text="Description" Foreground="{StaticResource FgMuted}" Margin="2,0,0,4"/>
                <TextBox Style="{StaticResource TextBoxBase}"
                         AcceptsReturn="True"
                         Height="140"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="12">
                <Button Content="Cancel"
                        Style="{StaticResource ButtonGhost}"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="Save"
                        Style="{StaticResource ButtonPrimary}"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
