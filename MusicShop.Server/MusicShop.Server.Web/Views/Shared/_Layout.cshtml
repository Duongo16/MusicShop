<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MusicShop</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MusicShop.Server.Web.styles.css" asp-append-version="true" />
</head>
<body style="background-color: #f0f2f5;">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand navbar-brand-logo" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-music-note text-primary"></i>
                    <span>Music</span>Shop
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav mx-auto flex-grow-1 justify-content-center">
                        <li class="nav-item">
                            <a class="nav-link text-dark mx-2" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark mx-2" asp-area="" asp-controller="Items" asp-action="Index">
                                <i class="bi bi-shop me-1"></i>Shop
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        @await Html.PartialAsync("_LoginPartial")
                    </div>
                </div>

            </div>
        </nav>
    </header>

   
    <main role="main">
        @RenderBody()
    </main>

    <footer class="main-footer bg-dark text-white pt-5 pb-4">
        <div class="container">
            <div class="row">
                <!-- Cột 1: Giới thiệu & Mạng xã hội -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="footer-logo mb-3">
                        <i class="bi bi-music-note text-primary"></i>
                        <span>Music</span>Shop
                    </h5>
                    <p class="footer-about">
                        Giai điệu của bạn, đam mê của chúng tôi. Cung cấp nhạc cụ chính hãng
                        với chất lượng và dịch vụ hàng đầu.
                    </p>
                    <div class="footer-social">
                        <a href="#" class="social-icon"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

                <!-- Cột 2: Mua sắm -->
                <div class="col-lg-2 col-6 mb-4">
                    <h5 class="footer-title">Mua sắm</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Item" asp-action="Index" asp-route-q="guitar">Guitar</a></li>
                        <li><a asp-controller="Item" asp-action="Index" asp-route-q="piano">Piano</a></li>
                        <li><a asp-controller="Item" asp-action="Index" asp-route-q="trống">Trống</a></li>
                        <li><a asp-controller="Item" asp-action="Index" asp-route-q="phụ kiện">Phụ kiện</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Về chúng tôi -->
                <div class="col-lg-3 col-6 mb-4">
                    <h5 class="footer-title">Thông tin</h5>
                    <ul class="footer-links">
                        <li><a href="#">Về MusicShop</a></li>
                        <li><a href="#">Hệ thống cửa hàng</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
                        <li><a href="#">Điều khoản dịch vụ</a></li>
                    </ul>
                </div>

                <!-- Cột 4: Hỗ trợ -->
                <div class="col-lg-3 col-md-6 mb-4">
                    <h5 class="footer-title">Hỗ trợ Khách hàng</h5>
                    <ul class="footer-links">
                        <li><a href="#">Câu hỏi thường gặp (FAQ)</a></li>
                        <li><a href="#">Chính sách bảo hành</a></li>
                        <li><a href="#">Chính sách đổi trả</a></li>
                        <li><a href="#">Liên hệ</a></li>
                    </ul>
                </div>
            </div>

            <!-- Dòng Copyright -->
            <div class="footer-bottom-bar text-center pt-3 mt-3 border-top border-secondary border-opacity-25">
                &copy; @DateTime.Now.Year - MusicShop - Giai Điệu Của Bạn, Đam Mê Của Chúng Tôi.
            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>