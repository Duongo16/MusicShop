@using MusicShop.Common.ViewModels
@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null; /* Bỏ layout mặc định để dùng layout full-page */
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Music Shop</title>
    <!-- Tải Bootstrap & Icons (Cần thiết cho icons) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Tải file theme (Cần thiết cho style) -->
    <link rel="stylesheet" href="~/css/theme.css" />
</head>
<body>

    <div class="auth-container">
        <div class="auth-card">
            <div class="text-center mb-4">
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-music-note-beamed text-primary" style="font-size: 3rem;"></i>
                </a>
            </div>
            <h2 class="auth-title">Tạo tài khoản</h2>
            <p class="auth-subtitle">Bắt đầu hành trình âm nhạc của bạn</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label auth-form-label"></label>
                    <input asp-for="Email" class="form-control auth-form-input" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label auth-form-label"></label>
                    <input asp-for="UserName" class="form-control auth-form-input" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label auth-form-label"></label>
                    <input asp-for="Password" class="form-control auth-form-input" type="password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label auth-form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control auth-form-input" type="password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-auth shadow mt-3">Đăng ký</button>

                <div class="auth-switch-link">
                    Đã có tài khoản? <a asp-action="Login">Đăng nhập</a>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>