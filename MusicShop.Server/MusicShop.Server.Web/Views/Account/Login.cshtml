@using MusicShop.Common.ViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null; /* Bỏ layout mặc định để dùng layout full-page */
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Music Shop</title>
    <!-- Tải Bootstrap & Icons (Cần thiết cho icons) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Tải file theme (Cần thiết cho style) -->
    <link rel="stylesheet" href="~/css/theme.css" />
</head>
<body>

    <div class="auth-container">
        <div class="auth-card">
            <div class="text-center mb-4">
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-music-note-beamed text-primary" style="font-size: 3rem;"></i>
                </a>
            </div>
            <h2 class="auth-title">Chào mừng trở lại!</h2>
            <p class="auth-subtitle">Đăng nhập để tiếp tục</p>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label auth-form-label"></label>
                    <input asp-for="Email" class="form-control auth-form-input" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label auth-form-label"></label>
                    <input asp-for="Password" class="form-control auth-form-input" type="password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="auth-options mb-3">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <a href="#" class="text-decoration-none" style="font-size: 0.9rem;">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="btn btn-primary btn-auth shadow">Đăng nhập</button>

                <div class="auth-switch-link">
                    Chưa có tài khoản? <a asp-action="Register" asp-route-returnurl="@Model.ReturnUrl">Đăng ký ngay</a>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>