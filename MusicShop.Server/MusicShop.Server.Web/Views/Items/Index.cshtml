@model MusicShop.Common.Models.PagedResult<MusicShop.Common.DTOs.ItemDetailOutDto>
@{
    var q = (string?)ViewData["q"] ?? "";
}


<div class="container mt-4 mb-5">

    <div class="row mb-4 justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="text-center">
                <h2 class="page-title d-flex align-items-center justify-content-center">
                    <i class="bi bi-music-note-list me-3 fs-1 text-primary"></i>
                    Khám phá Nhạc cụ
                </h2>
                <p class="text-muted fs-5">Tìm kiếm đàn, trống, và các phụ kiện âm nhạc yêu thích của bạn.</p>
            </div>

            <form method="get" class="mb-4 search-bar">
                <div class="input-group input-group-lg shadow-sm" style="border-radius: 0.5rem; overflow: hidden;">
                    <input type="text" name="q" value="@q" class="form-control" placeholder="Tìm kiếm đàn guitar, piano, trống..." aria-label="Tìm kiếm sản phẩm" />
                    <button class="btn btn-primary px-4" type="submit" id="button-search">
                        <i class="bi bi-search"></i>
                        <span class="d-none d-sm-inline ms-2">Tìm</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Items.Any())
    {
        <!-- THÔNG BÁO KHÔNG TÌM THẤY -->
        <div class="col-12">
            <div class="alert no-results-alert p-4 text-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-2 text-warning mb-2"></i>
                <h4 class="alert-heading">Không tìm thấy sản phẩm</h4>
                <p class="mb-0 text-muted">Rất tiếc, chúng tôi không tìm thấy sản phẩm nào phù hợp với từ khóa <strong class="text-dark">"@q"</strong>. Vui lòng thử lại với từ khóa khác.</p>
            </div>
        </div>
    }
    else
    {
        <!-- BỘ ĐẾM KẾT QUẢ & BỘ LỌC SẮP XẾP (ĐÃ NÂNG CẤP) -->
        <div class="row mb-3 align-items-center">
            <div class="col-md-6">
                <p class="text-muted mb-md-0">
                    Hiển thị <strong>@Model.Items.Count()</strong> trên tổng số <strong>@Model.TotalCount</strong> sản phẩm
                </p>
            </div>
            <div class="col-md-6 d-flex justify-content-md-end">
                <!-- TÍNH NĂNG NÂNG CẤP: BỘ LỌC SẮP XẾP -->
                <div class="input-group" style="width: auto;">
                    <label class="input-group-text" for="sortOrderSelect"><i class="bi bi-sort-down"></i></label>
                    <select class="form-select" id="sortOrderSelect" style="min-width: 200px;">
                        <option selected>Sắp xếp mặc định</option>
                        <option value="price_asc">Giá: Thấp đến Cao</option>
                        <option value="price_desc">Giá: Cao đến Thấp</option>
                        <option value="name_asc">Tên: A-Z</option>
                        <option value="name_desc">Tên: Z-A</option>
                    </select>
                </div>
                <!-- KẾT THÚC NÂNG CẤP -->
            </div>
        </div>

        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                <div class="col-6 col-lg-4 col-xl-3">
                    <div class="card h-100 shadow-sm product-card">

                        <!-- Ảnh sản phẩm & Badges -->
                        <div class="position-relative card-img-container">
                            <a asp-action="Details" asp-route-id="@item.Id" title="@item.Name">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://placehold.co/400x400/eeeeee/cccccc?text=Music+Item" : item.ImageUrl)"
                                     class="card-img-top"
                                     alt="@item.Name"
                                     onerror="this.onerror=null; this.src='https://placehold.co/400x400/eeeeee/cccccc?text=Image+Error';">
                            </a>

                            <!-- Badges -->
                            <div class="position-absolute top-0 start-0 m-2" style="z-index: 1;">
                                @if (item.SalePrice.HasValue && item.SalePrice < item.Price)
                                {
                                    <span class="badge bg-danger fs-6">SALE</span>
                                }
                                @if (item.StockQty == 0)
                                {
                                    <span class="badge bg-dark fs-6 ms-1">HẾT HÀNG</span>
                                }
                            </div>
                        </div>

                        <!-- Thân Card (Tên, Thương hiệu, Giá) -->
                        <div class="card-body d-flex flex-column pb-2 px-3">
                            @if (item.Brand != null)
                            {
                                <small class="text-muted mb-1">@item.Brand.Name</small>
                            }

                            <h5 class="card-title">
                                <a asp-action="Details" asp-route-id="@item.Id" title="@item.Name">
                                    @item.Name
                                </a>
                            </h5>

                            <!-- Giá sản phẩm (marginTop auto để đẩy xuống dưới) -->
                            <div class="mt-auto product-price">
                                @if (item.SalePrice.HasValue && item.SalePrice < item.Price)
                                {
                                    <span class="price-sale">@item.SalePrice.Value.ToString("N0")đ</span>
                                    <span class="price-original">@item.Price.ToString("N0")đ</span>
                                }
                                else
                                {
                                    <span class="price-normal">@item.Price.ToString("N0")đ</span>
                                }
                            </div>
                        </div>

                        <!-- Footer Card (Nút CTA) -->
                        <div class="card-footer">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-details w-100">
                                Xem chi tiết <i class="bi bi-arrow-right-short ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PHÂN TRANG -->
        <nav aria-label="Page navigation" class="mt-5">
            <ul class="pagination justify-content-center">
                @{
                    int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
                    int currentPage = Model.Page;
                    int maxPagesToShow = 5;
                    int startPage = Math.Max(1, currentPage - (maxPagesToShow / 2));
                    int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

                    if (endPage == totalPages)
                    {
                        startPage = Math.Max(1, totalPages - maxPagesToShow + 1);
                    }
                }

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { q = q, page = currentPage - 1 })" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                @if (startPage > 1)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { q = q, page = 1 })">1</a></li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { q = q, page = i })">@i</a>
                    </li>
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { q = q, page = totalPages })">@totalPages</a></li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { q = q, page = currentPage + 1 })" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>