@model MusicShop.Common.Models.PagedResult<MusicShop.Common.DTOs.ItemDetailOutDto>
@{
    var q = (string?)ViewData["q"] ?? "";
}

<style>
    .product-card {
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1) !important;
        }

        .product-card .card-img-top {
            aspect-ratio: 1 / 1;
            object-fit: cover;
        }

        .product-card .card-title {
            min-height: 48px;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .product-card .card-body {
            padding-bottom: 0.5rem;
        }

        .product-card .card-footer {
            background-color: #fff;
            border-top: none;
            padding-top: 0.5rem;
        }
</style>

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8 col-lg-6 mx-auto">
            <h2>Danh sách sản phẩm</h2>
            <form method="get" class="mb-3">
                <div class="input-group input-group-lg">
                    <input type="text" name="q" value="@q" class="form-control" placeholder="Tìm kiếm đàn, trống, phụ kiện..." />
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-search"></i> <span class="d-none d-sm-inline">Tìm</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="col-12 text-center">
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle-fill"></i> Không tìm thấy sản phẩm nào phù hợp với từ khóa "@q".
            </div>
        </div>
    }
    else
    {
        <div class="row mb-2">
            <div class="col">
                <small class="text-muted">
                    Hiển thị <strong>@Model.Items.Count()</strong> trên tổng số <strong>@Model.TotalCount</strong> sản phẩm
                </small>
            </div>
        </div>

        <div class="row">
            @foreach (var item in Model.Items)
            {
                <div class="col-6 col-lg-4 col-xl-3 mb-4">
                    <div class="card h-100 shadow-sm product-card">

                        <div class="position-relative">
                            <a asp-action="Details" asp-route-id="@item.Id">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder-product.png" : item.ImageUrl)"
                                     class="card-img-top"
                                     alt="@item.Name">
                            </a>

                            @if (item.SalePrice.HasValue && item.SalePrice < item.Price)
                            {
                                <span class="badge bg-danger position-absolute top-0 end-0 m-2" style="z-index: 1;">SALE</span>
                            }
                            @if (item.StockQty == 0)
                            {
                                <span class="badge bg-dark position-absolute top-0 start-0 m-2" style="z-index: 1;">HẾT HÀNG</span>
                            }
                        </div>

                        <div class="card-body d-flex flex-column pb-0">
                            @if (item.Brand != null)
                            {
                                <small class="text-muted">@item.Brand.Name</small>
                            }

                            <h5 class="card-title fs-6 mt-1 mb-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark" title="@item.Name">
                                    @item.Name
                                </a>
                            </h5>

                            <div class="mt-auto">
                                @if (item.SalePrice.HasValue && item.SalePrice < item.Price)
                                {
                                    <span class="fw-bold text-danger fs-5 me-2">@item.SalePrice.Value.ToString("N0")đ</span>
                                    <span class="text-muted text-decoration-line-through small">@item.Price.ToString("N0")đ</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-dark fs-5">@item.Price.ToString("N0")đ</span>
                                }
                            </div>
                        </div>

                        <div class="card-footer pt-2 pb-3">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary w-100 btn-sm">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mt-4">
                @{
                    int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
                    int currentPage = Model.Page;
                    int maxPagesToShow = 5; // Số trang tối đa hiển thị (ví dụ: 1 ... 3 4 [5] 6 7 ... 10)
                    int startPage = Math.Max(1, currentPage - (maxPagesToShow / 2));
                    int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

                    if (endPage == totalPages)
                    {
                        startPage = Math.Max(1, totalPages - maxPagesToShow + 1);
                    }
                }

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { q = q, page = currentPage - 1 })" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                @if (startPage > 1)
                {
                    <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { q = q, page = 1 })">1</a></li>
                    @if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { q = q, page = i })">@i</a>
                    </li>
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                    <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { q = q, page = totalPages })">@totalPages</a></li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { q = q, page = currentPage + 1 })" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>